#!/usr/bin/env python3
"""phone touch X,Y@MS ... | phone eval JS | phone open URL | phone trace [dump]

touch: a finger down at the first point (pixels of the 1080x2400 screen),
on through the next ones at 120 Hz (MS from the touch's start), up 8 ms
after the last: a touchscreen of its own (uinput), so all of Android's
input and Chrome's gestures see it. Each event is dated when it is due,
however late the busy phone gets to it (uinput's own tool dates an event
when it sends it: a few let go at once flung the tree to its end, at
times against the finger, or it dates them half a second early, and
Chrome then scrolls nothing until the finger is up).
eval: runs JS in Chrome's tab (remote debugging), prints its value as JSON
(a promise's once settled). open: the tab goes to URL.
trace: from now on the tab logs, per frame, touch and pointer events, the
tree's two scroll positions, its scroll ends, scrollTo calls with their
caller and long frames; trace dump prints that log, repeats folded."""
import base64, json, os, socket, struct, subprocess, sys, urllib.request

TRACE = """(() => {
  const t = document.querySelector("#tree .bracket"), p = document.querySelector("#tree .cols"), L = window.__trace = { ev: [], t0: performance.now() };
  const rec = (k, x) => L.ev.push([Math.round(performance.now() - L.t0), k, Math.round(t.scrollLeft * 10) / 10, Math.round(p.scrollTop), x ?? ""]);
  for (const k of ["pointerdown", "pointermove", "pointerup", "pointercancel"]) addEventListener(k, (e) => rec(k, Math.round(e.clientX) + "," + Math.round(e.clientY)), true);
  for (const k of ["touchstart", "touchmove", "touchend", "touchcancel"]) addEventListener(k, (e) => rec(k, (e.cancelable ? "" : "uncancelable ") + (e.changedTouches[0] ? Math.round(e.changedTouches[0].clientX) + "," + Math.round(e.changedTouches[0].clientY) : "")), { capture: true, passive: true });
  for (const k of ["scrollend", "click"]) t.addEventListener(k, () => rec(k), true);
  p.addEventListener("scrollend", () => rec("scrollend pane"));
  const to = Element.prototype.scrollTo;
  Element.prototype.scrollTo = function (...a) { this === t && rec("scrollTo", JSON.stringify(a[0]) + " " + (new Error().stack.split("\\n")[2] ?? "").trim()); return to.apply(this, a); };
  new PerformanceObserver((l) => l.getEntries().forEach((e) => L.ev.push([Math.round(e.startTime - L.t0), "long frame", Math.round(e.duration), Math.round(e.blockingDuration), e.scripts.map((s) => s.invoker + " " + Math.round(s.duration) + " ms").join("; ")]))).observe({ type: "long-animation-frame" });
  let last = "";
  const frame = () => { const k = t.scrollLeft.toFixed(1) + " " + Math.round(p.scrollTop); k === last || ((last = k), rec("frame")); window.__trace === L && requestAnimationFrame(frame); };
  requestAnimationFrame(frame);
  return "tracing: time ms, event, tree scrollLeft, columns scrollTop, more";
})()"""

def touch(points):
    pts = []
    for p in points:
        xy, t = p.split("@") if "@" in p else (p, "0")
        pts.append((*map(float, xy.split(",")), float(t)))
    out = [(pts[0][2], *pts[0][:2])]
    for (x0, y0, a), (x1, y1, b) in zip(pts, pts[1:]):
        n = max(1, round((b - a) * .12))
        out += [(a + (b - a) * k / n, x0 + (x1 - x0) * k / n, y0 + (y1 - y0) * k / n) for k in range(1, n + 1)]
    subprocess.run(["adb", "shell", "/data/local/tmp/touch"], input="".join("%.3f %d %d\n" % (t, round(x), round(y)) for t, x, y in out).encode(), check=True)

def page():
    tabs = json.load(urllib.request.urlopen("http://127.0.0.1:9222/json"))
    url = next(t for t in tabs if t["type"] == "page")["webSocketDebuggerUrl"]
    path = url.split("/", 3)[3]
    s = socket.create_connection(("127.0.0.1", 9222))
    s.sendall(("GET /%s HTTP/1.1\r\nHost: 127.0.0.1:9222\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: %s\r\nSec-WebSocket-Version: 13\r\n\r\n" % (path, base64.b64encode(os.urandom(16)).decode())).encode())
    f = s.makefile("rb")
    while f.readline() not in (b"\r\n", b""):
        pass
    def call(method, **params):
        data = json.dumps({"id": 1, "method": method, "params": params}).encode()
        n = len(data)
        head = struct.pack("!BB", 0x81, 0x80 | n) if n < 126 else struct.pack("!BBH", 0x81, 0xfe, n) if n < 65536 else struct.pack("!BBQ", 0x81, 0xff, n)
        s.sendall(head + b"\0\0\0\0" + data)
        while True:
            n = f.read(2)[1] & 127
            n = struct.unpack("!H", f.read(2))[0] if n == 126 else struct.unpack("!Q", f.read(8))[0] if n == 127 else n
            msg = json.loads(f.read(n))
            if msg.get("id") == 1:
                return msg
    return call

def run(js):
    res = page()("Runtime.evaluate", expression=js, awaitPromise=True, returnByValue=True).get("result", {})
    if "exceptionDetails" in res:
        sys.exit(json.dumps(res["exceptionDetails"]))
    return res.get("result", {}).get("value")

def dump():
    last, n = None, 0
    for e in json.loads(run("JSON.stringify(window.__trace?.ev.sort((a, b) => a[0] - b[0]) ?? [])")):
        if e[1] == last and e[1] in ("pointermove", "touchmove", "frame"):
            n += 1
            held = e
            continue
        if n:
            print("  ... %d more, the last:" % n, *held)
            n = 0
        print(*e)
        last = e[1]
    if n:
        print("  ... %d more, the last:" % n, *held)

def main(cmd, *args):
    if cmd == "touch":
        touch(args)
    elif cmd == "eval":
        print(json.dumps(run(" ".join(args))))
    elif cmd == "open":
        page()("Page.navigate", url=args[0])
    elif cmd == "trace":
        dump() if args == ("dump",) else print(run(TRACE))
    else:
        sys.exit(__doc__)

main(*sys.argv[1:]) if len(sys.argv) > 1 else sys.exit(__doc__)
